# Dev image for SvelteKit. Keeps all Node/pnpm tooling inside Docker.
FROM node:22-alpine

# Enable pnpm via corepack (bundled with Node 22)
RUN corepack enable && corepack prepare pnpm@latest --activate

# git is handy for some pnpm operations; tini for clean signal handling
RUN apk add --no-cache git tini

WORKDIR /app

# Vite dev server
EXPOSE 5173

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
