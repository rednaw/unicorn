{
  "name": "unicorn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite dev",
    "predev": "pnpm assets:encode",
    "build": "pnpm assets:encode && vite build && node scripts/service-worker.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "assets:encode": "node scripts/encode-audio.mjs && node scripts/encode-thumbs.mjs",
    "assets:thumbs": "node scripts/encode-thumbs.mjs",
    "assets:audio": "node scripts/encode-audio.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "18.0.1",
    "sharp": "^0.34.5",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.0",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11"
  }
}
