{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		":disableRateLimiting"
	],
	"labels": ["dependencies"],
	"rangeStrategy": "bump",
	"minimumReleaseAge": "1 day",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["at any time"]
	},
	"packageRules": [
		{
			"description": "Vitest + happy-dom — exact-pinned; bump as one group",
			"matchManagers": ["npm"],
			"matchPackageNames": ["vitest", "happy-dom", "@vitest/coverage-v8"],
			"groupName": "vitest suite"
		},
		{
			"description": "SvelteKit stack",
			"matchManagers": ["npm"],
			"groupName": "svelte stack",
			"matchPackageNames": [
				"/^@sveltejs//",
				"/^svelte$/",
				"/^svelte-check$/"
			]
		},
		{
			"description": "Vite + Tailwind build chain",
			"matchManagers": ["npm"],
			"groupName": "vite and tailwind",
			"matchPackageNames": [
				"/^vite$/",
				"/^@tailwindcss//",
				"/^tailwindcss$/"
			]
		},
		{
			"description": "GitHub Actions",
			"matchManagers": ["github-actions"],
			"groupName": "github actions"
		},
		{
			"description": "Devcontainer Node base image",
			"matchManagers": ["dockerfile"],
			"matchFileNames": [".devcontainer/Dockerfile"],
			"matchPackageNames": ["node"],
			"groupName": "node docker"
		}
	]
}
